{
  "name": "bugsnap-server",
  "version": "0.2.0",
  "private": true,
  "description": "Upload, storage, short links and viewer for BugSnap",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "smoke": "node test/smoke.js",
    "build:viewer": "node --env-file-if-exists=.env scripts/build-viewer.js",
    "test:drive": "node test/drive-mock.js",
    "user": "node --env-file-if-exists=.env scripts/user.js"
  },
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "express": "^4.21.2"
  }
}
