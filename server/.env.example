# Copy this file to server/.env and fill it in. See SETUP-GOOGLE-DRIVE.md.

# Google OAuth client (type "Desktop app") used by the server to upload to your Drive.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Browser API key the public player uses to stream shared files from Drive.
DRIVE_API_KEY=

# Address of your public player on GitHub Pages (no trailing slash), e.g.
# https://your-name.github.io/bugsnap-viewer
VIEWER_URL=

# AI bug reports: Claude Code on this computer is used by default (no key needed).
# To use the Claude API instead, paste a key on the settings page, or set it here:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# GitHub issues: paste a fine-grained token on the settings page, or set it here:
# GITHUB_TOKEN=

# Optional
# DRIVE_FOLDER_NAME=BugSnap
# PORT=4800
# HOST=127.0.0.1
# UPLOAD_TOKEN=
